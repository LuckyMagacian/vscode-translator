{
    "name": "AITranslator",
    "displayName": "AI Translator",
    "description": "Translate between any languages with AI-powered support.",
    "version": "0.0.1",
    "publisher": "",
    "icon": "logo.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/LuckyMagacian/vscode-translator.git"
    },
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Other",
        "Education"
    ],
    "keywords": [
        "Translator",
        "Translate",
        "AI",
        "LLM",
        "OpenAI",
        "Language"
    ],
    "activationEvents": [
        "*"
    ],
    "main": "./dist/extension",
    "contributes": {
        "commands": [
            {
                "command": "translator.translate",
                "title": "Translate"
            },
            {
                "command": "translator.replaceWithTranslation",
                "title": "Replace with Translation"
            },
            {
                "command": "translator.toggleCaptureWord",
                "title": "Toggle - Capture Word"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "translator.translate",
                    "group": "navigation@1"
                },
                {
                    "command": "translator.replaceWithTranslation",
                    "group": "navigation@2"
                }
            ]
        },
        "keybindings": [
            {
                "command": "translator.translate",
                "key": "ctrl+alt+z"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Translator",
            "properties": {
                "translator.captureWord": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to translate when hovering on a word."
                },
                "translator.siliconflow.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "API key for AI translation (OpenAI-compatible providers)"
                },
                "translator.siliconflow.model": {
                    "type": "string",
                    "default": "THUDM/GLM-4-9B-0414",
                    "description": "AI model for translation"
                },
                "translator.siliconflow.baseUrl": {
                    "type": "string",
                    "default": "https://api.siliconflow.cn/v1",
                    "description": "API base URL (compatible with OpenAI API)"
                },
                "translator.siliconflow.systemPrompt": {
                    "type": "string",
                    "default": "",
                    "description": "Custom system prompt for AI translation (leave empty for default)"
                },
                "translator.cacheEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable translation cache to avoid duplicate API calls"
                },
                "translator.cacheMaxSize": {
                    "type": "number",
                    "default": 200,
                    "description": "Maximum number of cached translations"
                },
                "translator.cacheTTL": {
                    "type": "number",
                    "default": 30,
                    "description": "Cache time-to-live in minutes"
                },
                "translator.firstLanguage": {
                    "type": "string",
                    "default": "Chinese",
                    "description": "First language (native or primary language). Non-first language text will be translated to this language."
                },
                "translator.secondLanguage": {
                    "type": "string",
                    "default": "English",
                    "description": "Second language (target language). First language text will be translated to this language."
                },
                "translator.enableLog": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable translation logging. When enabled, API request and response details will be shown in the output channel."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack --mode development",
        "watch": "webpack --mode development --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tsc": "tsc -p ./",
        "test": "npm run compile-tsc && node ./node_modules/vscode/bin/test",
        "tslint": "tslint --project tsconfig.json"
    },
    "devDependencies": {
        "@types/mocha": "^9.0.0",
        "@types/node": "^16.0.0",
        "@types/vscode": "^1.70.0",
        "ts-loader": "^9.6.2",
        "tslint": "^6.1.0",
        "typescript": "^4.9.0",
        "webpack": "^5.107.2",
        "webpack-cli": "^7.0.3"
    },
    "dependencies": {
        "applicationinsights": "^1.0.5",
        "openai": "^4.0.0"
    }
}
